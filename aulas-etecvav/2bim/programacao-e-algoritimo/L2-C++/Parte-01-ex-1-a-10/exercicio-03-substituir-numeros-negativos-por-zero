// Lê 10 números em um vetor e substitui todos os negativos por zero.
#include <iostream>

int main() {
    int vetor[10];
    int i;

    for (i = 0; i < 10; i++) {
        std::cout << "digite o numero da posicao " << i << ": ";
        std::cin >> vetor[i];
        
        if (vetor[i] < 0) {
            vetor[i] = 0;
        }
    }

    std::cout << "\nVetor resultante: ";
    for (i = 0; i < 10; i++) {
        std::cout << vetor[i] << " ";
    }
    std::cout << "\n";

    return 0;
}

* Descrição: 
*Ler o peso de uma pessoa em quilos, calcular e mostrar o peso em
*gramas.
*/
programa
{
	
	funcao inicio()
	{
	real kgs, gram
 	escreva("Calculo para ver sue peso em gramas")
 	escreva("Digite seu peso:")
 	leia(kgs)
 	gram = kgs*1000
 	escreva("Seu peso em gramas é:",gram,"")
	}
}
